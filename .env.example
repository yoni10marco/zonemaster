# Supabase (already configured)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for Strava sync: OAuth tokens are not readable by the
# browser, so all token access goes through the service role. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Strava API app (https://www.strava.com/settings/api).
# Set "Authorization Callback Domain" to your deployed domain (no path).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Vercel Cron sends this as `Authorization: Bearer <value>`. Use any long random
# string. The daily sync endpoint refuses to run without it.
CRON_SECRET=

# Gemini API key from Google AI Studio. Model is optional (default gemini-3.5-flash).
GEMINI_API_KEY=
GEMINI_MODEL=
